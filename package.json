{
  "name": "juju-grand-adventures",
  "displayName": "Juliet’s Grand Adventures",
  "version": "0.1.0",
  "description": "A little illustrated library of space adventures with Juliet, Uni, and Starbeard.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/starbeards-library.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "arcane doctor --app juju-grand-adventures",
    "dev": "arcane dev --app juju-grand-adventures",
    "import-map": "arcane import-map --workspace . --app juju-grand-adventures --output json",
    "package": "arcane package --app juju-grand-adventures",
    "verify": "arcane verify --app juju-grand-adventures",
    "bundle": "arcane bundle --app juju-grand-adventures",
    "build": "arcane build --target browser --app juju-grand-adventures",
    "run": "arcane run --target browser --app juju-grand-adventures"
  },
  "dependencies": {
    "arcane-os": "0.33.2"
  }
}
