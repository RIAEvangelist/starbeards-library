{
  "schemaVersion": 2,
  "id": "juju-grand-adventures",
  "displayName": "Juliet’s Grand Adventures",
  "description": "A little illustrated library of space adventures with Juliet, Uni, and Starbeard.",
  "version": "0.1.0",
  "publisher": {
    "id": "riaevangelist",
    "name": "RIAEvangelist"
  },
  "package": {
    "entry": "index.html",
    "strategy": "static",
    "include": [
      "app.js",
      "assets",
      "index.html",
      "manifest.json",
      "modules",
      "speech-consumer.mjs",
      "styles.css"
    ],
    "exclude": [],
    "shared": [
      "browser-runtime"
    ]
  },
  "permissions": {
    "capabilities": [],
    "methods": []
  },
  "security": {
    "connectOrigins": [],
    "frameOrigins": [],
    "mediaOrigins": []
  },
  "native": {
    "type": "app",
    "icon": null,
    "order": 100,
    "bundledApps": []
  },
  "requirements": {
    "arcaneProtocol": "arcane/1",
    "minimumCoreVersion": "0.8.12",
    "features": []
  },
  "targets": [
    "browser"
  ]
}
